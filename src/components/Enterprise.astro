---
import { Badge } from './ui/badge';

const capacidades = [
  "E-commerce completo",
  "Integraciones con plataformas externas (Didi, Rappi, UberEats)",
  "Sistemas ERP",
  "Arquitecturas multi-servicio",
];
---

<section id="proyectos-grandes" class="py-24 md:py-32 px-6 relative border-t border-border">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-20 items-center">

      <div class="scroll-reveal">
        <span class="font-mono text-[11px] text-ink-3 font-bold tracking-wider mb-4 block">
          Proyectos a mayor escala
        </span>
        <h2 class="text-[clamp(28px,4vw,44px)] font-bold tracking-tight text-foreground leading-[0.95] mb-5">
          ¿Tu negocio ya <span class="text-accent-val">superó</span><br />
          lo básico?
        </h2>
        <p class="text-base md:text-lg text-ink-2 leading-relaxed max-w-md">
          Cuando el reto ya no es un sistema de venta, sino conectar varias
          plataformas, procesos y equipos a la vez, el proyecto cambia de
          escala. También construyo eso.
        </p>
      </div>

      <div class="scroll-reveal">
        <div class="flex flex-wrap gap-2 mb-8">
          {capacidades.map(cap => (
            <Badge variant="secondary" className="text-[11px] px-3 py-1 font-medium tracking-wide border border-[var(--color-border-val)]">
              {cap}
            </Badge>
          ))}
        </div>
        <a
          href="#contacto"
          class="group/btn inline-flex items-center gap-3 border border-border text-foreground font-medium text-sm px-7 py-3.5 rounded-full transition-[background-color,box-shadow,transform] duration-150 ease-out hover:bg-[var(--color-surface-val)] active:scale-[0.96]"
        >
          Hablemos de tu proyecto
          <svg class="w-4 h-4 transition-transform duration-200 group-hover/btn:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </div>
</section>
