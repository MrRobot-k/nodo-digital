---
const servicios = [
  {
    titulo: "Sistemas a tu medida",
    texto: "¿Llevas ventas o inventario en cuaderno, Excel, o un sistema que no te sirve? Te construyo el que sí: punto de venta, control de inventario, reportes que entiendes de un vistazo.",
    tags: ["Empieza donde estás", "Crece cuando lo necesites", "Soporte continuo"],
    imagen: "/images/software-dev.webp",
  },
  {
    titulo: "Página web que trae clientes",
    texto: "No es solo una tarjeta de presentación digital. Conecta directo a WhatsApp para que la gente te contacte al momento, sin que se te escape ni un cliente por no contestar rápido.",
    tags: ["Pago único", "Carga rápida"],
    imagen: "/images/web-presence.webp",
  },
  {
    titulo: "Chatbot que contesta por ti",
    texto: "Tu WhatsApp respondiendo preguntas frecuentes, tomando pedidos o agendando citas, incluso cuando estás dormido o atendiendo el mostrador.",
    tags: ["Trabaja 24/7", "Sin intervención"],
    imagen: "/images/ai-automation.webp",
  },
  {
    titulo: "Programas gratis en lugar de los de pago",
    texto: "Muchas apps de pago tienen alternativas gratuitas que hacen lo mismo. Te las instalo y te las dejo configuradas y funcionando (ofimática, edición de imagen y video, diseño, contabilidad y más) para que dejes de pagar licencias o suscripciones que no necesitas.",
    tags: ["Sin licencias", "Instalación incluida", "Ahorro mensual"],
    imagen: "/images/free-software.webp",
  },
  {
    titulo: "Diagnóstico gratis de tu negocio",
    texto: "Antes de proponerte nada, te visito o platicamos por videollamada para entender cómo trabajas hoy. Si no hay algo que valga la pena automatizar, te lo digo. No te vendo por vender.",
    tags: ["Sin costo", "Sin compromiso"],
    imagen: "/images/consulting.webp",
  },
];
---

<section id="servicios" class="pt-28 pb-20 md:pt-40 md:pb-28 px-6 relative">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16 md:mb-24 scroll-reveal">
      <h2 class="text-[clamp(34px,5.5vw,60px)] font-bold tracking-tight text-foreground leading-[1] max-w-3xl">
        Lo que resuelvo para negocios como el tuyo
      </h2>
      <p class="text-base md:text-lg text-ink-2 leading-relaxed max-w-xl mt-6">
        No vendo software genérico. Cada sistema se construye para el problema específico que tienes hoy.
      </p>
    </div>

    <div class="space-y-20 md:space-y-28">
      {servicios.map((svc, i) => (
        <div class={i === 0 ? "scroll-reveal" : "grid md:grid-cols-12 gap-8 md:gap-12 items-center scroll-reveal"}>
          {i === 0 ? (
            <>
              <img
                src={svc.imagen}
                alt={svc.titulo}
                width="1600"
                height="1067"
                class="w-full h-[260px] md:h-[460px] object-cover rounded-md border border-border mb-8"
                loading="lazy"
                decoding="async"
              />
              <div class="grid md:grid-cols-12 gap-6 md:gap-12">
                <h3 class="md:col-span-5 text-3xl md:text-5xl font-semibold text-foreground leading-[1.05]">{svc.titulo}</h3>
                <div class="md:col-span-6 md:col-start-7">
                  <p class="text-ink-2 leading-relaxed mb-5 max-w-lg">{svc.texto}</p>
                  <p class="text-sm text-ink-3">{svc.tags.join(" · ")}</p>
                </div>
              </div>
            </>
          ) : (
            <>
              <div class={`md:col-span-5 ${i % 2 === 0 ? "md:order-2 md:col-start-8" : "md:order-1"}`}>
                <span class="block text-sm text-ink-3 mb-3 tabular-nums">{`0${i + 1}`}</span>
                <h3 class="text-2xl md:text-3xl font-semibold text-foreground leading-[1.1] mb-4">{svc.titulo}</h3>
                <p class="text-ink-2 leading-relaxed mb-4 max-w-md">{svc.texto}</p>
                <p class="text-sm text-ink-3 mb-6">{svc.tags.join(" · ")}</p>
                {i === servicios.length - 1 && (
                  <a
                    href="#contacto"
                    class="inline-flex items-center bg-primary text-primary-foreground font-medium text-sm px-6 py-3 rounded-md transition-[background-color,transform] duration-150 ease-out hover:bg-[var(--color-accent-h-val)] active:scale-[0.97]"
                  >
                    Pedir mi diagnóstico gratis
                  </a>
                )}
              </div>
              <div class={`md:col-span-6 ${i % 2 === 0 ? "md:order-1" : "md:order-2 md:col-start-7"}`}>
                <img
                  src={svc.imagen}
                  alt={svc.titulo}
                  width="1600"
                  height="1067"
                  class={`w-full object-cover rounded-md border border-border ${i % 2 === 0 ? "h-[240px] md:h-[320px]" : "h-[260px] md:h-[380px]"}`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
