---
import { Badge } from './ui/badge';

const servicios = [
  {
    titulo: "Sistemas a tu medida",
    texto: "¿Llevas ventas o inventario en cuaderno, Excel, o un sistema que no te sirve? Te construyo el que sí — punto de venta, control de inventario, reportes que entiendes de un vistazo.",
    tags: ["Empieza donde estás", "Crece cuando lo necesites", "Soporte continuo"],
    imagen: "/images/software-dev.webp",
  },
  {
    titulo: "Página web que trae clientes",
    texto: "No es solo una tarjeta de presentación digital. Conecta directo a WhatsApp para que la gente te contacte al momento, sin que se te escape ni un cliente por no contestar rápido.",
    tags: ["Pago único", "Rendimiento premium"],
    imagen: "/images/web-presence.webp",
  },
  {
    titulo: "Chatbot que contesta por ti",
    texto: "Tu WhatsApp respondiendo preguntas frecuentes, tomando pedidos o agendando citas — incluso cuando estás dormido o atendiendo el mostrador.",
    tags: ["Trabaja 24/7", "Sin intervención"],
    imagen: "/images/ai-automation.webp",
  },
  {
    titulo: "Programas gratis en lugar de los de pago",
    texto: "Muchas apps de pago tienen alternativas gratuitas que hacen lo mismo. Te las instalo y te las dejo configuradas y funcionando — ofimática, edición de imagen y video, diseño, contabilidad y más — para que dejes de pagar licencias o suscripciones que no necesitas.",
    tags: ["Sin licencias", "Instalación incluida", "Ahorro mensual"],
    imagen: "/images/free-software.webp",
  },
  {
    titulo: "Diagnóstico gratis de tu negocio",
    texto: "Antes de proponerte nada, te visito o platicamos por videollamada para entender cómo trabajas hoy. Si no hay algo que valga la pena automatizar, te lo digo — no te vendo por vender.",
    tags: ["Sin costo", "Sin compromiso"],
    imagen: "/images/consulting.webp",
  },
];
---

<section id="servicios" class="py-32 md:py-44 px-6 relative">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-20 md:mb-28">
      <div class="scroll-reveal">
        <h2 class="text-[clamp(36px,6vw,64px)] font-bold tracking-tight text-foreground leading-[0.92] max-w-4xl">
          Lo que resuelvo<br />
          <span class="text-accent-val">para negocios como el tuyo</span>
        </h2>
      </div>
      <p class="text-base md:text-lg text-ink-2 leading-relaxed max-w-xl mt-6">
        No vendo software genérico. Cada sistema se construye para el problema específico que tienes hoy.
      </p>
    </div>

    <!-- Service blocks -->
    <div class="space-y-24 md:space-y-32">
      {servicios.map((svc, i) => (
        <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
          <!-- Text side -->
          <div class={`scroll-reveal ${i % 2 === 1 ? "md:order-2" : "md:order-1"}`}>
            <h3 class="text-3xl md:text-4xl font-semibold text-foreground leading-[1.08] mb-5">
              {svc.titulo}
            </h3>
            <p class="text-ink-2 leading-relaxed mb-8 max-w-md">
              {svc.texto}
            </p>
            <div class="flex flex-wrap gap-2 mb-8">
              {svc.tags.map(tag => (
                <Badge variant="secondary" className="text-[11px] px-3 py-1 font-medium tracking-wide border border-[var(--color-border-val)]">
                  {tag}
                </Badge>
              ))}
            </div>
            {i === servicios.length - 1 && (
              <a
                href="#contacto"
                class="group/btn inline-flex items-center gap-3 bg-primary text-primary-foreground font-medium text-sm px-7 py-3.5 rounded-full transition-[background-color,box-shadow,transform] duration-150 ease-out hover:bg-[var(--color-accent-h-val)] hover:shadow-[0_0_25px_var(--color-accent-subtle-val)] active:scale-[0.96]"
              >
                Iniciar proyecto
                <svg class="w-4 h-4 transition-transform duration-200 group-hover/btn:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            )}
          </div>

          <!-- Image side -->
          <div class={`relative tilt-perspective ${i % 2 === 1 ? "md:order-1" : "md:order-2"}`}>
            <div class="tilt-card relative overflow-hidden rounded-xl border border-border">
              <img
                src={svc.imagen}
                alt={svc.titulo}
                width="1600"
                height="1067"
                class="w-full h-[300px] md:h-[400px] object-cover transition-transform duration-700 ease-out hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-tr from-background/60 via-background/10 to-transparent pointer-events-none" />
              <div class="tilt-glare absolute inset-0 pointer-events-none opacity-0" aria-hidden="true" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Focal moment: service images tilt in 3D toward the cursor, like the
  // custom software they represent responding directly to you.
  import { animate, onScroll, utils } from 'animejs';

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarsePointer = matchMedia('(pointer: coarse)').matches;

  document.querySelectorAll('.tilt-card').forEach((card) => {
    if (reduceMotion) return;

    utils.set(card, { opacity: 0, rotateX: 8, rotateY: -14, translateZ: -80 });
    animate(card, {
      opacity: [0, 1],
      rotateX: [8, 0],
      rotateY: [-14, 0],
      translateZ: [-80, 0],
      duration: 800,
      ease: 'outExpo',
      autoplay: onScroll({ target: card, enter: 'bottom-=15% top' }),
    });

    if (coarsePointer) return;

    const glare = card.querySelector('.tilt-glare');

    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      animate(card, {
        rotateY: (px - 0.5) * 16,
        rotateX: (0.5 - py) * 16,
        translateZ: 24,
        duration: 500,
        ease: 'outQuint',
      });
      if (glare) {
        glare.style.setProperty('--glare-x', `${px * 100}%`);
        glare.style.setProperty('--glare-y', `${py * 100}%`);
        glare.style.opacity = '1';
      }
    });

    card.addEventListener('pointerleave', () => {
      animate(card, { rotateX: 0, rotateY: 0, translateZ: 0, duration: 400, ease: 'outExpo' });
      if (glare) glare.style.opacity = '0';
    });
  });
</script>
