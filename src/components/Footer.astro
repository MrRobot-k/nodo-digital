---
import { Separator } from './ui/separator';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border py-20 px-6 relative">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-4 gap-12 mb-16 scroll-reveal">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-6 w-fit">
          <img src="/logo-icon.png" alt="" class="w-9 h-9" width="36" height="36" />
          <span class="text-xl font-bold tracking-tight text-foreground">Nodo Digital</span>
        </a>
        <p class="text-ink-2 leading-relaxed max-w-sm text-sm">
          Software y páginas web a la medida para negocios en todo México.
        </p>
      </div>

      <div>
        <span class="text-sm font-medium text-foreground block mb-5">Navegación</span>
        <nav class="space-y-3">
          <a href="#servicios" class="block text-sm text-ink-2 hover:text-foreground transition-colors duration-200 w-fit">Servicios</a>
          <a href="#about" class="block text-sm text-ink-2 hover:text-foreground transition-colors duration-200 w-fit">Proceso</a>
          <a href="#faq" class="block text-sm text-ink-2 hover:text-foreground transition-colors duration-200 w-fit">FAQ</a>
          <a href="#contacto" class="block text-sm text-ink-2 hover:text-foreground transition-colors duration-200 w-fit">Contacto</a>
        </nav>
      </div>

      <div>
        <span class="text-sm font-medium text-foreground block mb-5">Contacto</span>
        <a
          href="https://wa.me/528342550555"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-ink-2 hover:text-foreground transition-colors duration-200 group"
        >
          <svg class="w-4 h-4 transition-colors duration-200 group-hover:text-[var(--color-accent-val)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          834 255 0555
        </a>
        <a
          href="https://www.tiktok.com/@nododigital_ti"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-fit items-center gap-2 text-sm text-ink-2 hover:text-foreground transition-colors duration-200 group mt-3"
        >
          <svg class="w-4 h-4 transition-colors duration-200 group-hover:text-[var(--color-accent-val)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.6 6.7a4.8 4.8 0 0 1-3.8-4.2V2h-3.4v13.4a2.9 2.9 0 1 1-2-2.8V9.1a6.3 6.3 0 1 0 5.4 6.3V9a8.2 8.2 0 0 0 4.8 1.5V7.1a4.8 4.8 0 0 1-1-.4z"/></svg>
          @nododigital_ti
        </a>
      </div>
    </div>

    <Separator className="mb-8" />

    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-ink-3">
        &copy; {currentYear} Nodo Digital. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacidad" class="text-sm text-ink-3 hover:text-foreground transition-colors duration-200">
          Aviso de Privacidad
        </a>
      </div>
    </div>
  </div>
</footer>
