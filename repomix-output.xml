@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --font-sans: 'Geist Variable', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --color-canvas: var(--color-canvas-val);
  --color-ink: var(--color-ink-val);
  --color-ink-2: var(--color-ink-2-val);
  --color-ink-3: var(--color-ink-3-val);
  --color-accent-val: var(--color-accent-val);
  --color-accent-h: var(--color-accent-h-val);
  --color-accent-subtle: var(--color-accent-subtle-val);
  --color-border-val: var(--color-border-val);
  --color-surface: var(--color-surface-val);
  --color-surface-hover: var(--color-surface-hover-val);

  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
}

:root {
  --color-canvas-val: #070b0a;
  --color-ink-val: #fafafa;
  --color-ink-2-val: #a1a1aa;
  --color-ink-3-val: #96969c;
  --color-accent-val: #5ed29c;
  --color-accent-h-val: #4cbf87;
  --color-accent-subtle-val: rgba(94, 210, 156, 0.08);
  --color-border-val: rgba(255, 255, 255, 0.06);
  --color-surface-val: rgba(255, 255, 255, 0.03);
  --color-surface-hover-val: rgba(255, 255, 255, 0.05);

  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);

  --background: var(--color-canvas-val);
  --foreground: var(--color-ink-val);
  --card: var(--color-surface-val);
  --card-foreground: var(--color-ink-val);
  --popover: var(--color-canvas-val);
  --popover-foreground: var(--color-ink-val);
  --primary: var(--color-accent-val);
  --primary-foreground: #070b0a;
  --secondary: var(--color-surface-hover-val);
  --secondary-foreground: var(--color-ink-val);
  --muted: var(--color-surface-hover-val);
  --muted-foreground: var(--color-ink-2-val);
  --accent: var(--color-accent-subtle-val);
  --accent-foreground: var(--color-accent-val);
  --destructive: #ef4444;
  --border: var(--color-border-val);
  --input: rgba(255, 255, 255, 0.1);
  --ring: var(--color-accent-val);
  --radius: 14px;
}

.light {
  --color-canvas-val: #f5f5f0;
  --color-ink-val: #0a0a0a;
  --color-ink-2-val: #525252;
  --color-ink-3-val: #6b6b6b;
  --color-accent-val: #059669;
  --color-accent-h-val: #047857;
  --color-accent-subtle-val: rgba(5, 150, 105, 0.08);
  --color-border-val: rgba(0, 0, 0, 0.08);
  --color-surface-val: rgba(0, 0, 0, 0.02);
  --color-surface-hover-val: rgba(0, 0, 0, 0.04);

  --background: var(--color-canvas-val);
  --foreground: var(--color-ink-val);
  --card: var(--color-surface-val);
  --card-foreground: var(--color-ink-val);
  --popover: var(--color-canvas-val);
  --popover-foreground: var(--color-ink-val);
  --primary: var(--color-accent-val);
  --primary-foreground: #fafafa;
  --secondary: var(--color-surface-hover-val);
  --secondary-foreground: var(--color-ink-val);
  --muted: var(--color-surface-hover-val);
  --muted-foreground: var(--color-ink-3-val);
  --accent: var(--color-accent-subtle-val);
  --accent-foreground: var(--color-accent-val);
  --destructive: #dc2626;
  --border: var(--color-border-val);
  --input: rgba(0, 0, 0, 0.1);
  --ring: var(--color-accent-val);
  --radius: 14px;
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  html {
    @apply scroll-smooth;
    color-scheme: dark;
  }
  html.light {
    color-scheme: light;
  }
  body {
    @apply bg-background text-foreground font-sans antialiased;
    font-optical-sizing: auto;
  }
  h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
    line-height: 1.05;
  }
  h1 {
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  p {
    text-wrap: pretty;
    line-height: 1.6;
  }
  ::selection {
    background: rgba(94, 210, 156, 0.15);
  }
  .light ::selection {
    background: rgba(5, 150, 105, 0.15);
  }
  ::-moz-selection {
    background: rgba(94, 210, 156, 0.15);
  }
  .light ::-moz-selection {
    background: rgba(5, 150, 105, 0.15);
  }
}

/* ── Emil Kowalski: Press feedback ── */
@layer base {
  button, a {
    -webkit-tap-highlight-color: transparent;
  }
}

/* ── Scroll reveals ── */
.scroll-reveal {
  transition: opacity 0.8s var(--ease-spring),
              transform 0.8s var(--ease-spring);
}
.scroll-reveal.is-hidden {
  opacity: 0;
  transform: translateY(24px);
}
.scroll-reveal.revealed {
  opacity: 1;
  transform: translateY(0);
}

.clip-reveal {
  transition: clip-path 1.2s var(--ease-spring);
}
.clip-reveal.is-hidden {
  clip-path: inset(0 0 100% 0);
}
.clip-reveal.revealed {
  clip-path: inset(0 0 0 0);
}

.clip-reveal-right {
  transition: clip-path 1s var(--ease-out);
}
.clip-reveal-right.is-hidden {
  clip-path: inset(0 100% 0 0);
}
.clip-reveal-right.revealed {
  clip-path: inset(0 0 0 0);
}

.clip-reveal-top {
  transition: clip-path 0.8s var(--ease-out);
}
.clip-reveal-top.is-hidden {
  clip-path: inset(100% 0 0 0);
}
.clip-reveal-top.revealed {
  clip-path: inset(0 0 0 0);
}

.stagger-children > * {
  transition: opacity 0.6s var(--ease-spring),
              transform 0.6s var(--ease-spring);
}
.stagger-children.is-hidden > * {
  opacity: 0;
  transform: translateY(20px);
}
.stagger-children.revealed > *:nth-child(1) { transition-delay: 0ms; }
.stagger-children.revealed > *:nth-child(2) { transition-delay: 60ms; }
.stagger-children.revealed > *:nth-child(3) { transition-delay: 120ms; }
.stagger-children.revealed > *:nth-child(4) { transition-delay: 180ms; }
.stagger-children.revealed > *:nth-child(5) { transition-delay: 240ms; }
.stagger-children.revealed > *:nth-child(6) { transition-delay: 300ms; }
.stagger-children.revealed > * {
  opacity: 1;
  transform: translateY(0);
}

.hover-card {
  transition: transform 0.4s var(--ease-out),
              border-color 0.4s var(--ease-out),
              box-shadow 0.4s var(--ease-out);
  will-change: transform;
}
.hover-card:hover {
  transform: translateY(-6px);
  border-color: var(--color-accent-subtle-val);
  box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.45);
}

/* ── 3D tilt cards (anime.js-driven, see Services.astro) ──
   transform is written per-frame by JS, so it's deliberately excluded
   from this transition list to avoid fighting the animation engine. */
.tilt-perspective {
  perspective: 1400px;
}
.tilt-card {
  transition: border-color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  will-change: transform;
}
.tilt-card:hover {
  border-color: var(--color-accent-subtle-val);
  box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.45);
}
.tilt-glare {
  background: radial-gradient(circle at var(--glare-x, 50%) var(--glare-y, 50%), rgba(255, 255, 255, 0.18), transparent 45%);
  transition: opacity 0.3s var(--ease-out);
}

/* ── Impact 3D flip-reveal (anime.js-driven, see Impact.astro) ──
   transform is written per-frame by JS during entrance, so it's
   deliberately excluded here to avoid fighting the animation engine. */
.impact-perspective {
  perspective: 1200px;
}
.impact-flip {
  will-change: transform;
}

/* ── Enterprise depth-converge (anime.js-driven, see Enterprise.astro) ── */
.enterprise-perspective {
  perspective: 900px;
}
.enterprise-chip {
  will-change: transform;
}

/* ── Materials: translucent layers that float above content ──
   Weight scales with surface size: nav is a light, functional strip;
   panels are heavier, structural surfaces. Never stack two of these. */
.material-nav {
  background: color-mix(in srgb, var(--color-canvas-val) 62%, transparent);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.05);
  transition: box-shadow 0.4s var(--ease-out), background-color 0.4s var(--ease-out);
}
.material-nav.is-scrolled {
  box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.08),
              0 12px 30px -18px rgba(0, 0, 0, 0.6);
}

.material-panel {
  background: color-mix(in srgb, var(--color-surface-val) 100%, transparent);
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05),
              0 30px 70px -30px rgba(0, 0, 0, 0.55);
}

@media (prefers-reduced-transparency: reduce) {
  .material-nav,
  .material-panel {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: color-mix(in srgb, var(--color-ink-val) 6%, var(--color-canvas-val));
  }
}

@media (prefers-contrast: more) {
  .material-nav,
  .material-panel {
    background: var(--color-canvas-val);
    border: 1px solid var(--color-ink-2-val);
  }
}

.grain-overlay::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 256px 256px;
}

::-webkit-scrollbar {
  width: 4px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--color-accent-subtle-val);
  border-radius: 2px;
}
::-webkit-scrollbar-thumb:hover {
  background: color-mix(in srgb, var(--color-accent-val) 40%, transparent);
}

/* ── Section rhythm ── */
section + section {
  border-top: 1px solid;
  border-image: linear-gradient(
    to right,
    transparent,
    var(--color-border-val) 20%,
    var(--color-border-val) 80%,
    transparent
  ) 1;
}

/* ── Focus-visible polish ── */
:focus-visible {
  outline: 2px solid var(--color-accent-val);
  outline-offset: 2px;
}

/* ── Link underline animation ── */
.link-underline {
  position: relative;
}
.link-underline::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--color-accent-val);
  transition: width 0.3s var(--ease-out);
}
.link-underline:hover::after {
  width: 100%;
}

/* ── Image hover zoom ── */
.img-zoom {
  overflow: hidden;
}
.img-zoom img {
  transition: transform 0.6s var(--ease-out);
}
.img-zoom:hover img {
  transform: scale(1.04);
}

/* ── Badge glow on hover ── */
.badge-glow:hover {
  box-shadow: 0 0 12px var(--color-accent-subtle-val);
  border-color: var(--color-accent-val);
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.1s !important;
  }
  .scroll-reveal,
  .scroll-reveal.is-hidden,
  .clip-reveal,
  .clip-reveal.is-hidden,
  .clip-reveal-right,
  .clip-reveal-right.is-hidden,
  .clip-reveal-top,
  .clip-reveal-top.is-hidden,
  .stagger-children > *,
  .stagger-children.is-hidden > * {
    opacity: 1 !important;
    transform: none !important;
    clip-path: inset(0) !important;
  }
}
</file>

